{
  "expo": {
    "name": "WeekFlow",
    "slug": "weekflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "weekflow",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.weekflow.app",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071326"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071326",
          "image": "./assets/splash-official.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#071326",
            "image": "./assets/splash-official.png"
          }
        }
      ]
    ]
  }
}
