{
  "expo": {
    "name": "WeekFlow",
    "slug": "weekflow",
    "version": "0.3.18",
    "orientation": "portrait",
    "scheme": "weekflow",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.weekflow.app",
      "versionCode": 73,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#010417"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "./plugins/withPrivacyManifest",
      [
        "expo-image-picker",
        {
          "photosPermission": "WeekFlow necesita acceder a la imagen de tu horario para preparar la importación.",
          "cameraPermission": "WeekFlow necesita usar la cámara para fotografiar tu horario.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#010417",
          "image": "./assets/splash-official.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#010417",
            "image": "./assets/splash-official.png"
          }
        }
      ]
    ]
  }
}
